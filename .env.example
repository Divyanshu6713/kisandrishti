# Kisan Drishti — copy to .env.local and fill in what you need.
# Everything prefixed VITE_ is compiled into the browser bundle and is PUBLIC.
# Never put a secret (Supabase service-role key, database password, private API key) here.

# ---- Authentication (optional) ----
# Leave both empty to run in Demo mode: only the labelled "Demo Login" is available.
# Set both to enable real Supabase Auth (email/phone + password). Use the *anon / publishable* key.
# Demo Login then uses Supabase anonymous sign-in (enable it in Auth → Providers).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Farm data + models (existing switches) ----
# VITE_DATA_SOURCE=local          # local | rest
# VITE_API_BASE=                  # e.g. https://api.example.com (also add it to connect-src in security-headers.mjs + render.yaml)
# VITE_DISEASE_MODEL=demo         # demo | remote
# VITE_RISK_MODEL=demo            # demo | remote
# VITE_ASSISTANT=rules            # rules | remote
# VITE_DEMO_LATENCY=260           # ms of artificial delay in demo mode

# Live weather needs no key: Open-Meteo (forecast + geocoding), India Post (PIN lookup)
# and BigDataCloud (locality name for "Use my location") are free, key-less public APIs.

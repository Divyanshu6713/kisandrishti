# Kisan Drishti ML backend — copy to backend/.env (git-ignored) and fill in.
# Paths are relative to backend/ unless absolute. Never commit real keys.

# ---- Storage (local disk for the MVP) ----
ML_STORAGE_PATH=storage
# DATASET_STORAGE_PATH=        # default <ML_STORAGE_PATH>/datasets
# MODEL_STORAGE_PATH=          # default <ML_STORAGE_PATH>/models
# CHECKPOINT_STORAGE_PATH=     # default <ML_STORAGE_PATH>/checkpoints
# EVALUATION_STORAGE_PATH=     # default <ML_STORAGE_PATH>/evaluations
# TEMP_STORAGE_PATH=           # default <ML_STORAGE_PATH>/temp
# PRETRAINED_WEIGHTS_PATH=     # default <ML_STORAGE_PATH>/weights (torchvision ImageNet weights cache)
# ML_DATABASE_PATH=            # default <ML_STORAGE_PATH>/kisan_ml.sqlite3

# ---- Administrators (required for the admin area) ----
# name:key pairs, comma-separated; each key at least 24 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ML_ADMIN_KEYS=
# ML_SESSION_SECRET=           # signs admin sessions; auto-generated into storage/.session_secret if empty
# ML_ADMIN_SESSION_HOURS=8
# Optional: allow Supabase accounts (when the site uses Supabase Auth)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=         # only for legacy HS256 projects; newer projects are verified via JWKS
# ML_ADMIN_EMAILS=             # comma-separated
# ML_ADMIN_USER_IDS=           # comma-separated Supabase user ids (or set app_metadata.role = "ml_admin")

# ---- Upload limits ----
# MAX_DATASET_UPLOAD_SIZE=8589934592        # 8 GB (bytes)
# MAX_DATASET_UNCOMPRESSED_SIZE=21474836480 # 20 GB
# MAX_DATASET_FILES=400000
# MAX_COMPRESSION_RATIO=100
# MAX_IMAGE_PIXELS=40000000
# MIN_IMAGES_PER_CLASS_WARNING=30
# STALE_UPLOAD_HOURS=24
# KEEP_UPLOAD_ARCHIVES=false

# ---- Training worker ----
# TRAINING_DEVICE=auto          # auto | cuda | cpu
# TRAINING_NUM_WORKERS=2        # DataLoader processes
# ML_WORKER_AUTOSTART=true      # the API starts one worker; set false when the worker runs elsewhere
# ML_WORKER_POLL_SECONDS=2

# ---- Inference ----
# INFERENCE_DEVICE=cpu
# MODEL_CONFIDENCE_THRESHOLD=0.65   # default; admins can change it in Deployment
# MAX_PREDICT_IMAGE_SIZE=8388608    # 8 MB
# PREDICT_RATE_LIMIT_PER_MIN=30     # per client IP, per API process

# ---- Web ----
CORS_ORIGINS=http://localhost:5240,http://127.0.0.1:5240,http://localhost:5241

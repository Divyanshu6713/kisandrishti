# Single-page app routing for Apache/LiteSpeed (Hostinger).
# Serve real files/folders as-is; send every other *page* path (e.g. /app/organic) to index.html
# so React Router can render it on refresh or direct links.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # Missing build files must return a real 404 — never index.html. Otherwise an old tab asking
  # for a file from a previous deployment receives HTML instead of JavaScript and the page fails.
  RewriteCond %{REQUEST_URI} ^/assets/ [OR]
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|map|json|woff2?|png|jpe?g|svg|ico|webp)$ [NC]
  RewriteRule ^ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Always revalidate index.html so new deployments show up immediately;
# hashed files in /assets never change, so they can be cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
